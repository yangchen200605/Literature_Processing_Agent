# DeepSeek API 配置
DEEPSEEK_API_KEY=sk-your_deepseek_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Semantic Scholar（可选；申请后可降低限流）
# https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# 可选：外部 stdio MCP Server（留空则用内存 MCP）
# MCP_SCHOLAR_COMMAND=python -m app.mcp_server

# 服务端口
PORT=8001

# RAG（可选；默认分块 800 字、检索 top-6）
# RAG_CHUNK_SIZE=800
# RAG_CHUNK_OVERLAP=120
# RAG_TOP_K=6
# RAG_AGENT_MAX_ITERATIONS=2
# RAG_AGENT_MAX_SUB_QUERIES=3
